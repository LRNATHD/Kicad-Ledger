# ==============================================================================
# KiCad-StockCheck: Local & Private by Design
# ==============================================================================
# All personal inventory databases, distributor order receipts, invoices, and
# user-specific configuration files are strictly excluded from git tracking.
# ==============================================================================

# User Inventory Database & Cache
*.db
*.sqlite
*.sqlite3
data/
local_data/

# User Order Receipts, Invoices, and BOM exports
orders/
my_orders/
invoices/
user_data/
*.receipt.csv

# Ignore all user CSV / XLSX files in the root or data folders
/*.csv
/*.tsv
/*.xlsx
/*.xls

# Allow sample data and test fixture CSVs
!examples/**
!tests/**

# User Configuration & Local Settings
config.json
user_settings.json
settings.local.json
*.local

# Logs and runtime artifacts
*.log
*.tmp
*.bak

# KiCad temporary & project lock files
*.kicad_prl
*.kicad_pcb-bak
*-save.kicad_pcb
*.kicad_sch-bak
fp-info-cache

# Python environment & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Editor & OS files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
